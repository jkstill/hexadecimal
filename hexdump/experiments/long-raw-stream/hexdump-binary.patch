+-- The JVM resolves these private call specifications only when invoked.
+function stream_open(stmt varchar2, bind_type varchar2, bind_text varchar2, bind_number number) return binary_integer
+as language java name 'HexdumpLongRaw.open(java.lang.String, java.lang.String, java.lang.String, java.math.BigDecimal) return int';
+function stream_next(id binary_integer) return binary_integer
+as language java name 'HexdumpLongRaw.next(int) return int';
+function stream_read(id binary_integer) return raw
+as language java name 'HexdumpLongRaw.read(int) return byte[]';
+procedure stream_close(id binary_integer)
+as language java name 'HexdumpLongRaw.close(int)';
+
+function hexdump_long_raw (
+		tab_name_in varchar2,
+		tab_owner_in varchar2 default null,
+		tab_column_in varchar2,
+		where_clause_in varchar2,
+		where_bind_val sys.anydata default null
+	) return t_hexdump_tab pipelined is
+	bind_type varchar2(128);
+	bind_text varchar2(32767);
+	bind_number number;
+	reader_id binary_integer;
+	stmt varchar2(32767);
+	buf raw(8192);
+	line_bytes raw(16);
+	line t_hexdump_row;
+	header t_hdr_row;
+	byte_offset number;
+	pos pls_integer;
+	procedure cleanup is
+	begin
+		if reader_id is not null then
+			stream_close(reader_id);
+			reader_id := null;
+		end if;
+	end;
+begin
+	if instr(where_clause_in, ';') > 0 then
+		raise_application_error(-20001, 'Semicolon in WHERE clause');
+	end if;
+	stmt := 'select ' || dbms_assert.enquote_name(tab_column_in) || ' from '
+		|| case when tab_owner_in is not null then dbms_assert.enquote_name(tab_owner_in) || '.' end
+		|| dbms_assert.enquote_name(tab_name_in) || ' ' || where_clause_in;
+	if where_bind_val is not null then
+		bind_type := where_bind_val.gettypename();
+		case bind_type
+			when 'SYS.NUMBER' then bind_number := where_bind_val.accessnumber();
+			when 'SYS.VARCHAR2' then bind_text := where_bind_val.accessvarchar2();
+			else raise_application_error(-20002, 'Expected a NUMBER or VARCHAR2 bind');
+		end case;
+	end if;
+	reader_id := stream_open(stmt, bind_type, bind_text, bind_number);
+	while stream_next(reader_id) = 1 loop
+		for h in (select * from table(dump_hdr(header))) loop
+			line.address := h.address;
+			line.data := h.data;
+			line.text := h.text;
+			pipe row(line);
+		end loop;
+		byte_offset := 0;
+		loop
+			buf := stream_read(reader_id);
+			exit when buf is null;
+			pos := 1;
+			while pos <= utl_raw.length(buf) loop
+				line_bytes := utl_raw.substr(buf, pos, least(16, utl_raw.length(buf) - pos + 1));
+				line.address := lpad(to_char(byte_offset,'FMXXXXXXXX'),8,'0');
+				line.data := rtrim(regexp_replace(rawtohex(line_bytes),'(..)','\1 '));
+				line.text := safe_to_print(line_bytes);
+				pipe row(line);
+				pos := pos + 16;
+				byte_offset := byte_offset + utl_raw.length(line_bytes);
+			end loop;
+		end loop;
+	end loop;
+	cleanup;
+	return;
+exception
+	when no_data_needed then cleanup; return;
+	when others then cleanup; raise;
+end;
+
